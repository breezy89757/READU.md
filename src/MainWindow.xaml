<winuiex:WindowEx
    x:Class="ReadU.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ReadU"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winuiex="using:WinUIEx"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:sizers="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:ReadU.Models"
    MinWidth="800"
    MinHeight="600"
    mc:Ignorable="d"
    Title="READU.md">

    <Grid x:Name="MainGrid" AllowDrop="True" DragOver="MainGrid_DragOver" Drop="MainGrid_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Bar (Row 0) -->
        <Grid x:Name="TitleBar" Height="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- App Icon + Title -->
            <Image Grid.Column="0" Source="Images/Square44x44Logo.png" Width="16" Height="16" Margin="12,0,4,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="READU.md" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"/>

            <!-- Title Bar Buttons (non-draggable) -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" Margin="0,0,140,0" VerticalAlignment="Center">
                <Button x:Name="HomeButton" Click="HomeButton_Click" ToolTipService.ToolTip="Welcome Page (Home)"
                        Background="Transparent" BorderThickness="0" Padding="6" Width="32" Height="32">
                    <FontIcon Glyph="&#xE80F;" FontSize="14" />
                </Button>
                <Button x:Name="OpenButton" Click="OpenButton_Click" ToolTipService.ToolTip="Open File (Ctrl+O)"
                        Background="Transparent" BorderThickness="0" Padding="6" Width="32" Height="32">
                    <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                </Button>
                <Button x:Name="EditToggleButton" Click="EditToggleButton_Click" ToolTipService.ToolTip="Toggle Edit Mode (Ctrl+E)"
                        Background="Transparent" BorderThickness="0" Padding="6" Width="32" Height="32">
                    <FontIcon x:Name="EditToggleIcon" Glyph="&#xE70F;" FontSize="14" />
                </Button>
                <Button x:Name="ZoomOutButton" Click="ZoomOutButton_Click" ToolTipService.ToolTip="Zoom Out (Ctrl+-)"
                        Background="Transparent" BorderThickness="0" Padding="6" Width="32" Height="32">
                    <FontIcon Glyph="&#xE71F;" FontSize="14" />
                </Button>
                <TextBlock x:Name="ZoomLevelText" Text="100%" VerticalAlignment="Center" Margin="4,0" Width="36" TextAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}" />
                <Button x:Name="ZoomInButton" Click="ZoomInButton_Click" ToolTipService.ToolTip="Zoom In (Ctrl++)"
                        Background="Transparent" BorderThickness="0" Padding="6" Width="32" Height="32">
                    <FontIcon Glyph="&#xE8A3;" FontSize="14" />
                </Button>
                <Button x:Name="PrintButton" Click="PrintButton_Click" ToolTipService.ToolTip="Print (Ctrl+P)"
                        Background="Transparent" BorderThickness="0" Padding="6" Width="32" Height="32">
                    <FontIcon Glyph="&#xE749;" FontSize="14" />
                </Button>
                <AppBarSeparator Margin="2,4" />
                <Button x:Name="ScreenshotButton" Click="ScreenshotButton_Click" ToolTipService.ToolTip="Full Page Screenshot (Ctrl+Shift+S)"
                        Background="Transparent" BorderThickness="0" Padding="6" Width="32" Height="32">
                    <FontIcon Glyph="&#xE722;" FontSize="14" />
                </Button>
                <AppBarSeparator Margin="2,4" />
                <Button x:Name="AiSettingsButton" Click="AiSettingsButton_Click" ToolTipService.ToolTip="AI Settings"
                        Background="Transparent" BorderThickness="0" Padding="6" Width="32" Height="32">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                </Button>
                <Button x:Name="SummarizeButton" Click="SummarizeButton_Click" ToolTipService.ToolTip="AI Summary"
                        Background="Transparent" BorderThickness="0" Padding="8,6" Height="32" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Message" />
                        <TextBlock Text="AI" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Tab Bar (Row 1) -->
        <TabView x:Name="TabBar" Grid.Row="1"
                 IsAddTabButtonVisible="True"
                 AddTabButtonClick="TabBar_AddTabButtonClick"
                 TabCloseRequested="TabBar_TabCloseRequested"
                 SelectionChanged="TabBar_SelectionChanged"
                 CanDragTabs="True"
                 CanReorderTabs="True"
                 TabWidthMode="SizeToContent"
                 VerticalAlignment="Top">
            <TabView.TabStripHeader>
                <Grid />
            </TabView.TabStripHeader>
            <TabView.TabStripFooter>
                <Grid />
            </TabView.TabStripFooter>
        </TabView>

        <!-- Main Content Area (Row 2) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="150" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar (TOC) -->
            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Table of Contents" Margin="16,12" FontWeight="SemiBold" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ListView Grid.Row="1" x:Name="TocListView" ItemsSource="{x:Bind TocItems, Mode=OneWay}" SelectionMode="Single" SelectionChanged="TocListView_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:TocItem">
                                <StackPanel Orientation="Horizontal" Margin="{x:Bind IndentMargin}">
                                    <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- TOC Splitter -->
            <sizers:GridSplitter Grid.Column="1" Width="8" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" />

            <!-- Content Panel (Read or Edit mode) -->
            <Grid x:Name="ContentPanel" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="SummaryPanel"
                        Grid.Row="0"
                        Margin="12,12,12,0"
                        Padding="16"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="SummaryHeaderTextBlock"
                                       Text="AI Summary"
                                       FontWeight="SemiBold"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <ProgressRing x:Name="SummaryProgressRing"
                                              Width="18"
                                              Height="18"
                                              Visibility="Collapsed"
                                              IsActive="False" />
                                <Button x:Name="SummaryCopyButton"
                                    Click="SummaryCopyButton_Click"
                                    Content="Copy"
                                    IsEnabled="False" />
                                <Button x:Name="SummaryCloseButton"
                                        Click="SummaryCloseButton_Click"
                                        Content="Close" />
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="SummaryStatusTextBlock"
                                   Grid.Row="1"
                                   Margin="0,12,0,0"
                                   Visibility="Collapsed"
                                   TextWrapping="WrapWholeWords" />

                        <ScrollViewer Grid.Row="2"
                                      Margin="0,12,0,0"
                                      MaxHeight="240"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="SummaryItemsControl" ItemsSource="{x:Bind SummaryItems, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="•" Margin="0,0,8,0" VerticalAlignment="Top" />
                                            <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="WrapWholeWords" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Read Mode: WebView2 only -->
                <controls:WebView2 x:Name="MarkdownWebView" Grid.Row="1" />

                <!-- Edit Mode: split pane (hidden by default) -->
                <Grid x:Name="EditModePanel" Grid.Row="1" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="EditorTextBox"
                             Grid.Column="0"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             IsSpellCheckEnabled="False"
                             FontFamily="Cascadia Code, Cascadia Mono, Consolas, Courier New, monospace"
                             FontSize="14"
                             Padding="16,12"
                             PlaceholderText="Type Markdown here..."
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             TextChanged="EditorTextBox_TextChanged"
                             BorderThickness="0" />

                    <sizers:GridSplitter Grid.Column="1" Width="8" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" />

                    <controls:WebView2 x:Name="PreviewWebView" Grid.Column="2" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</winuiex:WindowEx>

